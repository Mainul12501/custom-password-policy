{
    "name": "mainul/password-policy",
    "description": "A Laravel package for password policy enforcement: validation rules, expiry, and reuse prevention",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "password",
        "policy",
        "security",
        "validation",
        "expiry"
    ],
    "authors": [
        {
            "name": "Mainul Islam"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/routing": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/hashing": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/validation": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/auth": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/console": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/mail": "^10.0|^11.0|^12.0|^13.0"
    },
    "suggest": {
        "xenon/laravelbdsms": "Required to deliver temporary passwords by SMS when a user has no company email (policy 3.1.3).",
        "laravel/sanctum": "Default authentication guard for the JSON API (api.guard = sanctum).",
        "laravel/passport": "Alternative API authentication: set api.guard to your passport guard."
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Mainul\\PasswordPolicy\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mainul\\PasswordPolicy\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mainul\\PasswordPolicy\\PasswordPolicyServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
